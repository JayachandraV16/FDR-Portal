# Copy to backend/.env and adjust. Never commit .env.
APP_ENV=development
# Must match the credentials in the root .env used by docker-compose.yml.
# Use 127.0.0.1, not localhost: on Windows/Docker Desktop "localhost" can stall for seconds on IPv6.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/fdr_portal
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]
# Private document storage root (used from Checkpoint 3). Relative paths resolve against backend/.
STORAGE_DIR=storage
# Required. At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Session cookie settings. COOKIE_SECURE=false is accepted only for development/test
# (plain http://localhost); it is rejected when APP_ENV=production.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# Optional: only for PostgreSQL-specific tests. Must point at a database whose name ends
# in "_test" and that differs from DATABASE_URL. The tests drop and recreate its schema.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/fdr_portal_test
# Optional LLM-assisted extraction. Disabled by default; no code uses it yet.
LLM_ENABLED=false
# Optional document extraction. Embedded PDF text works with no setup. To also read scanned PDFs and
# images, install Tesseract and either put it on PATH or set its full path here. Without it, such
# documents report OCR_UNAVAILABLE instead of producing values. Nothing is sent over the network.
# OCR_COMMAND=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_LANGUAGE=eng
# EXTRACTION_MAX_PAGES=10
# EXTRACTION_TIMEOUT_SECONDS=30
# Hindi/Marathi scans need the matching Tesseract language data (eng, hin and mar). If a configured language
# is not installed, scanned documents report OCR_LANGUAGE_UNAVAILABLE instead of being read.
# OCR_LANGUAGE=eng+hin+mar
# Background extraction: jobs are rows in the database and workers are threads in the API process.
# EXTRACTION_WORKERS=0 starts none (jobs then wait in the queue). The queue limit counts pending + running jobs.
# EXTRACTION_WORKERS=2
# EXTRACTION_QUEUE_LIMIT=20
# EXTRACTION_MAX_ATTEMPTS=3
# EXTRACTION_POLL_SECONDS=2

# FDR Copilot (the in-app assistant). It works without any of these: with CHAT_PROVIDER unset it answers from
# built-in help and your own records. Set them only to let an OpenAI-compatible service re-word answers; the
# service then receives the question and non-sensitive facts only (never amounts, names or document text).
# https is required unless the URL is http://127.0.0.1 or http://localhost. Keep the key out of the repository.
# CHAT_PROVIDER=openai_compatible
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_MODEL=
# CHAT_TIMEOUT_SECONDS=15
# CHAT_MAX_MESSAGE_CHARS=1000

# --- Google Gemini (optional AI wording for FDR Copilot) -------------------------------------------------------
# Instead of the generic settings above, FDR Copilot can use the Gemini API (models.generateContent):
#   CHAT_PROVIDER=gemini
#   CHAT_API_KEY=YOUR_GEMINI_API_KEY        (create one in Google AI Studio; keep it out of git and out of the frontend)
#   CHAT_MODEL=YOUR_SUPPORTED_GEMINI_MODEL  (a model id your account can use; check ai.google.dev/gemini-api/docs/pricing)
#   CHAT_BASE_URL is optional for Gemini; leave it unset to use https://generativelanguage.googleapis.com/v1beta
# Free-tier availability, limits and data use are set by Google and your account and can change. Google states that
# free-tier content may be used to improve its products, so use demonstration data only. If the key is missing, wrong
# or the quota is used up, FDR Copilot keeps working from its built-in answers and says so.

# Reviewer workload dashboard. There is no official review deadline in the system, so none is assumed. Leave this
# unset to show elapsed waiting time only; set a number of days to also count FDRs beyond (and approaching) a LOCAL
# threshold of your own. It is a local setting, not an AICTE rule, and the dashboard says so.
# REVIEW_SLA_DAYS=
